{
  "name": "blockbench-mcp",
  "version": "0.4.0",
  "description": "Blockbench MCP server: let AI (Claude, Cursor) create Minecraft models, textures, rigs and animations in Blockbench, take screenshots, install plugins and more.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "blockbench-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "npm run build && node --test \"test/**/*.test.js\""
  },
  "files": [
    "dist",
    "plugin"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "blockbench",
    "blockbench-mcp",
    "blockbench-plugin",
    "minecraft",
    "minecraft-models",
    "geckolib",
    "claude",
    "cursor",
    "3d",
    "modeling",
    "ai"
  ],
  "license": "MIT",
  "author": "sosadly (https://github.com/sosadly)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sosadly/blockbench-mcp.git"
  },
  "homepage": "https://github.com/sosadly/blockbench-mcp#readme",
  "bugs": {
    "url": "https://github.com/sosadly/blockbench-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
